depends=(
  "carbonio-openjdk"
  "pending-setups"
)
source=(
  "${pkgname}"
  "${pkgname}-intentions.json"
  "${pkgname}-legacy.service"
  "${pkgname}-policies.json"
  "${pkgname}-quarkus.tar.gz"
