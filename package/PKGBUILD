  "${pkgname}-intentions.json"
  "${pkgname}-legacy.service"
  "${pkgname}-policies.json"
  "${pkgname}-quarkus.tar.gz"
  "${pkgname}-service-protocol.json"
  "${pkgname}-setup"
  "${pkgname}-sidecar-legacy.service"
  "${pkgname}-sidecar.service"
  "${pkgname}.hcl"
  "${pkgname}.service"
  "421-${pkgname}.sh"
  "systemd-sysuser.conf"
  "systemd-tmpfile.conf"
)

