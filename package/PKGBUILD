)
arch=('x86_64')
section="admin"
priority="optional"
url="https://www.zextras.com/"
makedepends=(
  "rsync"
)
depends=(
  "carbonio-openjdk"
  "pending-setups"
)
source=(
  "${pkgname}"
  "${pkgname}.hcl"
  "${pkgname}-intentions.json"
  "${pkgname}-pending-setup.sh"
  "${pkgname}-policies.json"
  "${pkgname}.service"
  "${pkgname}-service-protocol.json"
  "${pkgname}-setup"
  "${pkgname}-sidecar.service"
)
sha256sums=('599d10048be4ae408c498bba33b157015006d61916d4a051cfdbf31933f130cc'
  'ccc87f71a36915a2006a37f7c3fef4f934e1f1b0c6e43d8f03dc2200f3d56940'
  '5fed7682316886fcd053b545c42a25ff2fc9d5da949e3da97134e70e8ab25450'
  '1d00aac2847a15cfd990d64ba36d092caf82905280f9fba599d4d4edf40492ed'
  '376c53798291548ef9968a60b4dbef6fdd9c255a6dac11adc6b1cfcc42c2b727'
