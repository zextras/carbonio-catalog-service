_package() {
  install -Ddm755 \
    "${pkgdir}/usr/share/carbonio/carbonio-catalog"
  cp -a "${srcdir}/quarkus-app/"* \
    "${pkgdir}/usr/share/carbonio/carbonio-catalog/"

  install -Dm755 "${srcdir}/carbonio-catalog-setup" \
    "${pkgdir}/usr/bin/carbonio-catalog-setup"

  install -Dm644 "${srcdir}/carbonio-catalog.hcl" \
    "${pkgdir}/etc/zextras/service-discover/carbonio-catalog.hcl"

  install -Dm644 "${srcdir}/421-carbonio-catalog.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/421-carbonio-catalog.sh"

  install -Dm644 "${srcdir}/carbonio-catalog-intentions.json" \
    "${pkgdir}/etc/carbonio/catalog/service-discover/intentions.json"

  install -Dm644 "${srcdir}/carbonio-catalog-policies.json" \
    "${pkgdir}/etc/carbonio/catalog/service-discover/policies.json"

  install -Dm644 "${srcdir}/carbonio-catalog-service-protocol.json" \
    "${pkgdir}/etc/carbonio/catalog/service-discover/service-protocol.json"

  install -Dm644 "${srcdir}/systemd-sysuser.conf" \
    "${pkgdir}/usr/lib/sysusers.d/carbonio-catalog.conf"

  install -Dm644 "${srcdir}/systemd-tmpfile.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/carbonio-catalog.conf"
}

_package_legacy() {
  install -Dm644 "${srcdir}/carbonio-catalog-legacy.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-catalog.service"
  install -Dm644 "${srcdir}/carbonio-catalog-sidecar-legacy.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-catalog-sidecar.service"
}

_package_systemd() {
  install -Dm644 "${srcdir}/carbonio-catalog.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-catalog.service"
  install -Dm644 "${srcdir}/carbonio-catalog-sidecar.service" \
    "${pkgdir}/usr/lib/systemd/system/carbonio-catalog-sidecar.service"
}

package() {
  _package
  _package_systemd
}

package__rocky_8() {
  _package
  _package_legacy
}

package__rocky_9() {
  _package
  _package_systemd
}

package__ubuntu_jammy() {
  _package
  _package_legacy
}

package__ubuntu_noble() {
  _package
  _package_systemd
}

postinst() {
  systemd-sysusers /usr/lib/sysusers.d/carbonio-catalog.conf >/dev/null 2>&1 || :
  systemd-tmpfiles --create /usr/lib/tmpfiles.d/carbonio-catalog.conf >/dev/null 2>&1 || :

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-catalog.service >/dev/null 2>&1 || :
    systemctl enable carbonio-catalog-sidecar.service >/dev/null 2>&1 || :
    systemctl start carbonio-catalog
  fi

  echo "======================================================"
  echo "Carbonio Catalog installed successfully!     "
  echo "You must run pending-setups to configure it correctly."
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable --now carbonio-catalog.service >/dev/null 2>&1 || :
    systemctl --no-reload disable --now carbonio-catalog-sidecar.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  rm -f /etc/carbonio/catalog/service-discover/token

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
