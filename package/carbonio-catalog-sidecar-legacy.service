[Unit]
Description=Carbonio Catalog Sidecar
Documentation=https://docs.zextras.com/zextras-suite-documentation/latest/
Requires=network-online.target
After=network-online.target

[Service]
User=carbonio-catalog
ExecStart=/usr/bin/consul connect envoy \
    -token-file /etc/carbonio/catalog/service-discover/token \
    -admin-bind localhost:0 \
    -sidecar-for carbonio-catalog
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=15s
KillSignal=SIGINT
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
