[Unit]
Description=Carbonio Catalog Daemon
Wants=network.target carbonio-catalog-sidecar.service
Requires=network-online.target
After=network-online.target
PartOf=carbonio-mta.target carbonio-proxy.target

[Service]
Type=simple
ExecStart=/usr/bin/carbonio-catalog
User=carbonio-catalog
Group=carbonio-catalog
Restart=on-failure
RestartSec=15s
TimeoutSec=60s
TimeoutStopSec=120s

# Hardening
PrivateTmp=yes
ProtectSystem=strict
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=carbonio-mta.target carbonio-proxy.target
